# 1. 核心：所有IP访问/未绑定域名访问 → 禁止访问
server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        # 禁止IP访问，返回403
        return 403;
}

# 2. 域名的HTTP访问 → 强制跳转到HTTPS
server {
        listen 80;
        listen [::]:80;
        server_name aioj.top;  # 替换成你的实际域名
        return 301 https://$host$request_uri;
}

# 3. 禁止通过IP访问HTTPS（443端口）
server {
        listen 443 ssl http2 default_server;
        listen [::]:443 ssl http2 default_server;
        server_name _;
        # 配置一个自签名证书占位符（用于处理IP访问时的SSL握手）
        ssl_certificate /etc/nginx/ssl/default.crt;
        ssl_certificate_key /etc/nginx/ssl/default.key;
        # 禁止IP访问，返回403
        return 403;
}

# 4. 域名的HTTPS主配置（443端口）- 保留所有HUSTOJ原有配置
server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;

        # 你的域名
        server_name aioj.top;  # 替换成你的实际域名

        # 腾讯云SSL证书路径（替换成你证书的实际路径）
        ssl_certificate /etc/nginx/ssl/aioj.crt;        # 证书文件
        ssl_certificate_key /etc/nginx/ssl/aioj.key;    # 私钥文件

        # HTTPS安全配置
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # 原HUSTOJ配置 - 完全保留
        root /home/judge/src/web;
        index index.php index.html index.htm index.nginx-debian.html;

        location / {
                try_files $uri $uri/ =404;
                limit_conn perip 10;    # 单个客户端IP连接数限制
                limit_conn perserver 100; # 服务器总连接数限制
        }

        # 静态上传目录整体强缓存：目录内均为一次性写入的静态资源（上传同名文件时服务端
        # 自动改名保证 URL 唯一，课件封面另有 ?v= 版本参数），可放心长期缓存。
        # ^~ 使请求不再检查 server 级正则 location（含 .php$ 的 fastcgi 入口），天然不落
        # PHP-FPM；嵌套 403 为纵深防御，防日后误删 ^~ 或改动 location 结构时防线失效
        location ^~ /upload/ {
                expires 30d;
                access_log off;
                location ~* \.(php|phtml)$ {
                        return 403;
                }
        }

        # 课程表主题底图：append-only（新主题=新文件名），改图走 TIMETABLE_THEMES
        # img 路径加 ?v= 破缓存（仓库惯例）；结构与 /upload/ 块一致
        location ^~ /image/course_schedule/ {
                expires 30d;
                access_log off;
                location ~* \.(php|phtml)$ {
                        return 403;
                }
        }

        # 课程表圆体字体：woff2 按 unicode-range 切片，文件名固定内容不可变，长期强缓存；
        # zcool-kuaile.css 靠 ?v= 破缓存（timetable.php 引用处递增版本号）
        location ^~ /template/syzoj/fonts/ {
                expires 1y;
                access_log off;
        }

        # 离线游戏包目录：仅供积分兑换流程内部使用（许可证由 PHP 调 Python 生成、
        # 安装包走外链下载），无任何合法 HTTP 直访场景，整体 404 防直链白嫖与源码/工具泄露。
        # ^~ 阻止该目录下任何请求（含混入的 .php）进入后续正则 location
        location ^~ /offline-games/ {
                return 404;
        }

        # PHP解析配置 - 完全保留
        # 注意：php7.4 为占位符，fix_nginx_conf.sh 部署时会自动检测并替换为实际版本
        location ~ \.php$ {
                include snippets/fastcgi-php.conf;
                fastcgi_pass unix:/var/run/php/php7.4-fpm.sock;
                limit_conn perip 10;    # 单个客户端IP连接数限制
                limit_conn perserver 100; # 服务器总连接数限制
        }

        # 禁止访问.htaccess文件
        location ~ /\.ht {
                deny all;
        }
}